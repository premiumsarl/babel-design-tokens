{
  "$meta": {
    "name": "Babel Design Tokens",
    "brand": "Black core + Bronze accent",
    "canonicalBrand": "#B08D57",
    "note": "Single source of truth. Edit here, then `npm run build` to regenerate every platform. Never hand-edit dist/.",
    "refSyntax": "String values wrapped in {curly.dotted.path} are aliases resolved to another token's value at build time."
  },

  "color": {
    "brand": {
      "50":  "#faf5ec",
      "100": "#f2e6d0",
      "200": "#e6cfa8",
      "300": "#d6b37e",
      "400": "#c39e6a",
      "500": "#b08d57",
      "600": "#96774a",
      "700": "#7c6139",
      "800": "#5f4a2c",
      "900": "#45351f"
    },
    "neutral": {
      "25":  "#faf8f5",
      "50":  "#f4f1ea",
      "100": "#e9e4d9",
      "200": "#ddd5c7",
      "300": "#c4bbaa",
      "400": "#968c79",
      "500": "#6f6656",
      "600": "#564e40",
      "700": "#3f3830",
      "800": "#2a251d",
      "900": "#201a12",
      "950": "#14110c"
    },
    "success": {
      "50":  "#e6f6ee",
      "100": "#c6ecd8",
      "500": "#32ba7c",
      "600": "#1f9e66",
      "700": "#0f7a4d",
      "400": "#56d29a"
    },
    "warning": {
      "50":  "#fff3d9",
      "100": "#ffe4ad",
      "500": "#ffa800",
      "600": "#cc8600",
      "700": "#8a5a00",
      "400": "#f0c04a"
    },
    "error": {
      "50":  "#fdecea",
      "100": "#f9cfca",
      "500": "#ff5050",
      "600": "#dc2626",
      "700": "#c62828",
      "400": "#ff9a8f"
    },
    "info": {
      "50":  "#e8f0fe",
      "100": "#cfe0fd",
      "500": "#3b82f6",
      "600": "#2f6fe0",
      "700": "#1d63d1",
      "400": "#6fb0ff"
    },
    "chart": {
      "1": "{color.brand.500}",
      "2": "{color.info.500}",
      "3": "{color.success.500}",
      "4": "{color.warning.500}",
      "5": "#8b5cf6",
      "6": "#ef4444",
      "7": "#14b8a6",
      "8": "#ec4899"
    }
  },

  "semantic": {
    "core":          { "light": "{color.neutral.950}", "dark": "{color.neutral.50}" },
    "coreHover":     { "light": "{color.neutral.800}", "dark": "{color.neutral.200}" },
    "onCore":        { "light": "#ffffff",             "dark": "{color.neutral.950}" },

    "accent":        { "light": "{color.brand.500}",   "dark": "{color.brand.400}" },
    "accentStrong":  { "light": "{color.brand.700}",   "dark": "{color.brand.300}" },
    "onAccent":      { "light": "#ffffff",             "dark": "{color.neutral.950}" },
    "focusRing":     { "light": "{color.brand.700}",   "dark": "{color.brand.300}" },

    "canvas":        { "light": "{color.neutral.50}",  "dark": "{color.neutral.950}" },
    "surface":       { "light": "#ffffff",             "dark": "{color.neutral.900}" },
    "surfaceSunken": { "light": "{color.neutral.50}",  "dark": "{color.neutral.800}" },

    "border":        { "light": "{color.neutral.200}", "dark": "{color.neutral.800}" },
    "borderStrong":  { "light": "{color.neutral.300}", "dark": "{color.neutral.700}" },

    "text":          { "light": "{color.neutral.900}", "dark": "{color.neutral.50}" },
    "textSecondary": { "light": "{color.neutral.600}", "dark": "{color.neutral.300}" },
    "textMuted":     { "light": "{color.neutral.400}", "dark": "{color.neutral.500}" },
    "link":          { "light": "{color.brand.700}",   "dark": "{color.brand.300}" },

    "successBg":     { "light": "{color.success.50}",  "dark": "#10301f" },
    "successText":   { "light": "{color.success.700}", "dark": "{color.success.400}" },
    "warningBg":     { "light": "{color.warning.50}",  "dark": "#33280b" },
    "warningText":   { "light": "{color.warning.700}", "dark": "{color.warning.400}" },
    "errorBg":       { "light": "{color.error.50}",    "dark": "#2c1815" },
    "errorText":     { "light": "{color.error.700}",   "dark": "{color.error.400}" },
    "errorSolid":    { "light": "{color.error.600}",   "dark": "{color.error.600}" },
    "infoBg":        { "light": "{color.info.50}",     "dark": "#12233f" },
    "infoText":      { "light": "{color.info.700}",    "dark": "{color.info.400}" }
  },

  "font": {
    "family": {
      "display": "\"Space Grotesk\", ui-sans-serif, system-ui, sans-serif",
      "body":    "\"Inter\", ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
      "mono":    "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Consolas, monospace"
    },
    "size": {
      "xs": 11, "sm": 12, "base": 14, "md": 15, "lg": 17,
      "xl": 20, "2xl": 24, "3xl": 30, "4xl": 36
    },
    "weight": {
      "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800
    },
    "leading": { "tight": 1.15, "normal": 1.5, "relaxed": 1.65 },
    "tracking": { "tight": "-0.02em", "normal": "0", "wide": "0.08em" }
  },

  "space": {
    "0": 0, "px": 1, "0_5": 2, "1": 4, "2": 8, "3": 12, "4": 16,
    "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80
  },

  "radius": {
    "sm": 6, "md": 9, "lg": 12, "xl": 16, "2xl": 22, "full": 9999
  },

  "shadow": {
    "sm": {
      "light": "0 6px 16px -10px rgba(45,32,15,.30)",
      "dark":  "0 8px 20px -12px rgba(0,0,0,.60)"
    },
    "md": {
      "light": "0 12px 30px -14px rgba(45,32,15,.32), 0 2px 6px -2px rgba(45,32,15,.10)",
      "dark":  "0 16px 40px -16px rgba(0,0,0,.66), 0 2px 8px -2px rgba(0,0,0,.5)"
    },
    "lg": {
      "light": "0 22px 56px -22px rgba(45,32,15,.34), 0 2px 8px -2px rgba(45,32,15,.12)",
      "dark":  "0 26px 64px -22px rgba(0,0,0,.72), 0 2px 10px -2px rgba(0,0,0,.5)"
    }
  },

  "z": {
    "dropdown": 100, "sticky": 200, "overlay": 900, "modal": 1000, "toast": 1100
  }
}
