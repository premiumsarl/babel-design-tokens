{
  "$meta": {
    "name": "Babel API error codes",
    "description": "Every stable `error.<domain>.<action>` code the API can return in the `errorCode` field of an error envelope. Clients switch on the CODE and render their own localized copy; the English `message` is the fallback.",
    "owner": "server",
    "onUnknown": "preserve",
    "onUnknownNote": "A client that does not recognize a code MUST fall back to the server's `message`, never blank the error. Codes are added every release; an old binary meeting a new code is normal, not a defect.",
    "provenance": {
      "seededFrom": "babel-lambda-api/src/i18n/errors.ts — `export enum ErrorCode` (lines 21-565)",
      "measuredOn": "2026-08-10",
      "count": 215
    },
    "drift": {
      "note": "The API owns this list outright; the drift is in how much of it each client can name. Counts are `api_error_*` i18n keys per client.",
      "api": "215 codes declared",
      "apiTranslated": "202 of 215 have an ERROR_MESSAGES entry",
      "admin": "172 api_error_* keys (src/i18n/{en,fr,es,zh}.json)",
      "mobile": "125 api_error_* keys (assets/i18n/*.json); only 21 codes are named in code at lib/common/errors/exceptions.dart"
    },
    "untranslated": {
      "note": "Declared in the enum but absent from the API's own ERROR_MESSAGES map, so they fall back to the raw English server message in every language. Listed here so the gap is visible rather than silent — NOT a separate contract; these are ordinary codes.",
      "names": [
        "OTP_RESEND_COOLDOWN",
        "ACCOUNT_CLAIMED",
        "CHARGE_POOL_NOT_FOUND",
        "CHARGE_POOL_WEIGHTS_INVALID",
        "AP_PO_NOT_FOUND",
